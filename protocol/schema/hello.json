{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "hello",
  "type": "object",
  "required": ["type", "role", "protocol_version"],
  "properties": {
    "type": { "const": "hello" },
    "role": { "enum": ["host", "ipad", "android"] },
    "protocol_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" }
  },
  "additionalProperties": false
}
