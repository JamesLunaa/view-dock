# Maintainer: James Luna <josecynonluna03@gmail.com>
pkgname=view-dock
pkgver=2.0.3
pkgrel=1
pkgdesc='Use an iPad or Android device as an extended second display for Linux (X11)'
arch=('any')
url='https://github.com/JamesLunaa/view-dock'
license=('GPL-3.0-or-later')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
depends=(
  'python'
  'python-av'
  'python-websockets'
  'python-jsonschema'
  'python-mss'
  'python-numpy'
  'python-xlib'
  'python-aiortc'   # AUR
  'python-uinput'   # AUR
  'ffmpeg'
  'xorg-server'
  'xorg-xrandr'
  'xf86-video-dummy'
)
optdepends=(
  'usbmuxd: iPad over USB (the -git versions of usbmuxd/libimobiledevice are known to work)'
  'libimobiledevice: iPad over USB'
  'android-tools: Android over USB (adb forward)'
  'pyside6: tray applet (python -m host.gui)'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('3726605361523c31b4334b2662728407311274a0ce0d46ed8abbebf50c5accb6')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"

  # Helper scripts the docs tell users to run. Kept side by side because
  # start-dummy-display.sh finds ../xorg/dummy.conf relative to itself.
  # launch-gui.sh and install-desktop-entry.sh are left out: they assume a
  # repo checkout with a .venv, and the package provides `view-dock-tray`.
  local _s
  for _s in force-connector start-dummy-display launch-on-virtual-display; do
    install -Dm755 "host/scripts/$_s.sh" "$pkgdir/usr/share/$pkgname/scripts/$_s.sh"
  done
  install -Dm644 host/xorg/dummy.conf "$pkgdir/usr/share/$pkgname/xorg/dummy.conf"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 host/README.md "$pkgdir/usr/share/doc/$pkgname/host-README.md"

  # Load uinput at boot (touch/pencil input injection needs it)
  echo uinput | install -Dm644 /dev/stdin "$pkgdir/usr/lib/modules-load.d/$pkgname.conf"
}
